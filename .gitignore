# Unity-generated folders: rebuilt from Assets, Packages and ProjectSettings on import.
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Per-user editor state (layouts, search index, last opened scene).
/[Uu]ser[Ss]ettings/

# Build output.
/[Bb]uild/
/[Bb]uilds/
*.apk
*.aab
*.app
*.unitypackage

# IDE solution files and caches: Unity regenerates them.
.vs/
.idea/
.vscode/
*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.DotSettings.user
/[Aa]ssets/Plugins/Editor/JetBrains*

# Debug symbols and crash leftovers.
*.pdb
*.pdb.meta
*.mdb
*.mdb.meta
*.pidb
*.pidb.meta
*.opendb
*.VC.db
sysinfo.txt
mono_crash.*
crashlytics-build.properties

# Scenes the test runner creates while running play mode tests.
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Operating system clutter.
.DS_Store
Thumbs.db
desktop.ini
